datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// IDENTITY & ACCESS MANAGEMENT
// -------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  role          String    // SUPER_ADMIN, UNIVERSITY_ADMIN, REGISTRAR, FINANCE_OFFICER, EXAM_CONTROLLER, DEPT_HEAD, FACULTY, STUDENT
  firstName     String
  lastName      String
  phone         String?
  cnic          String?   @unique
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile  Student?
  facultyProfile  Faculty?
  sessions        Session[]
  refreshTokens   RefreshToken[]
  loginActivities LoginActivity[]
  auditLogs       AuditLog[]
  accessibility   UserAccessibilitySetting?
  notifications   Notification[]
  sentMessages    Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginActivity {
  id        String   @id @default(uuid())
  userId    String
  action    String   // LOGIN, LOGOUT
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  String?
  newValue  String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model UserAccessibilitySetting {
  id           String   @id @default(uuid())
  userId       String   @unique
  fontSize     String   @default("default") // small, default, large, xlarge
  highContrast Boolean  @default(false)
  darkMode     Boolean  @default(false)
  reduceMotion Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// UNIVERSITY STRUCTURE
// -------------------------------------------------------------

model University {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  logoUrl   String?
  website   String?
  createdAt DateTime @default(now())

  campuses Campus[]
}

model Campus {
  id           String   @id @default(uuid())
  universityId String
  name         String
  code         String   @unique
  city         String

  university  University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departments Department[]
  classrooms  Classroom[]
}

model Department {
  id         String   @id @default(uuid())
  campusId   String
  name       String
  code       String   @unique
  headOfDept String?

  campus        Campus         @relation(fields: [campusId], references: [id], onDelete: Cascade)
  programs      Program[]
  faculty       Faculty[]
  courses       Course[]
  announcements Announcement[]
  students      Student[]
}

model Program {
  id            String   @id @default(uuid())
  departmentId  String
  name          String
  code          String   @unique
  degreeLevel   String   // UNDERGRADUATE, GRADUATE, POSTGRADUATE
  durationYears Int      @default(4)
  totalCredits  Int      @default(134)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  students   Student[]
  sections   Section[]
  plos       ProgramLearningOutcome[]
  feeStructures FeeStructure[]
}

model Semester {
  id               String   @id @default(uuid())
  name             String   // e.g. "Fall 2026"
  code             String   @unique
  academicSession  String   // e.g. "2026-2027"
  startDate        DateTime
  endDate          DateTime
  isCurrent        Boolean  @default(false)
  registrationOpen Boolean  @default(false)

  sections         Section[]
  courseOfferings  CourseOffering[]
  academicRecords  StudentAcademicRecord[]
  examinations     Examination[]
  feeChallans      FeeChallan[]
  financialLedgers FinancialLedger[]
  currentStudents  Student[] @relation("CurrentSemester")
}

model Section {
  id         String   @id @default(uuid())
  programId  String
  semesterId String
  name       String   // e.g. "A", "B"

  program         Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  semester        Semester         @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  students        Student[]
  courseOfferings CourseOffering[]
}

model Classroom {
  id         String   @id @default(uuid())
  campusId   String
  roomNumber String
  name       String   // e.g. "Quiet Room", "COMPUTING LAB-II", "R-201", "Auditorium"
  capacity   Int      @default(50)
  roomType   String   // LECTURE_HALL, LAB, AUDITORIUM, CONFERENCE

  campus          Campus           @relation(fields: [campusId], references: [id], onDelete: Cascade)
  courseOfferings CourseOffering[]
  examRooms       ExamRoom[]
  timetables      Timetable[]
}

// -------------------------------------------------------------
// FACULTY & INSTRUCTORS
// -------------------------------------------------------------

model Faculty {
  id             String   @id @default(uuid())
  userId         String   @unique
  departmentId   String
  designation    String   // Assistant Professor, Lecturer, Associate Professor, Dean
  specialization String?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  offerings       CourseOffering[]
  examInvigilator ExamRoom[]
}

// -------------------------------------------------------------
// STUDENT MANAGEMENT
// -------------------------------------------------------------

model Student {
  id                String   @id @default(uuid())
  userId            String   @unique
  registrationNo    String   @unique // e.g. 23SP-052-SE
  enrollmentNo      String   @unique // e.g. UITU-23SP-UGRAD-00236
  departmentId      String
  programId         String
  currentSemesterId String
  sectionId         String
  admissionDate     DateTime @default(now())
  academicStatus    String   @default("Active") // Active, Suspended, Graduated, Probation
  currentBalance    Float    @default(0.0)
  loanAmount        Float    @default(0.0)
  cgpa              Float    @default(0.0)
  completedCredits  Int      @default(0)

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department              @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  program         Program                 @relation(fields: [programId], references: [id], onDelete: Cascade)
  currentSemester Semester                @relation("CurrentSemester", fields: [currentSemesterId], references: [id])
  section         Section                 @relation(fields: [sectionId], references: [id])
  
  registrations   CourseRegistration[]
  academicRecords StudentAcademicRecord[]
  attendance      AttendanceRecord[]
  assessmentResults AssessmentResult[]
  grades          Grade[]
  examSeats       ExamSeat[]
  admitCards      AdmitCard[]
  examAttempts    ExamAttempt[]
  financialLedgers FinancialLedger[]
  challans        FeeChallan[]
  payments        Payment[]
  advances        StudentAdvance[]
  adjustments     FinancialAdjustment[]
  ploAttainments  PLOAttainment[]
  todos           Todo[]
  workflows       Workflow[]
  supportTickets  SupportTicket[]
  surveyResponses SurveyResponse[]
}

model StudentAcademicRecord {
  id               String   @id @default(uuid())
  studentId        String
  semesterId       String
  semesterName     String
  gpa              Float
  creditsAttempted Int
  creditsEarned    Int
  academicStanding String   @default("Good Standing")

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// COURSES, REGISTRATION & TIMETABLE
// -------------------------------------------------------------

model Course {
  id            String   @id @default(uuid())
  departmentId  String
  code          String   @unique // e.g. "SE-301"
  name          String   // e.g. "Software Construction and Development"
  creditHours   Int      @default(3)
  lectureHours  Int      @default(3)
  labHours      Int      @default(0)
  isElective    Boolean  @default(false)
  description   String?

  department    Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  offerings     CourseOffering[]
  prerequisites CoursePrerequisite[] @relation("TargetCourse")
  requiredFor   CoursePrerequisite[] @relation("PrereqCourse")
  ploMappings   CoursePLOMapping[]
}

model CoursePrerequisite {
  id                   String @id @default(uuid())
  courseId             String
  prerequisiteCourseId String

  course             Course @relation("TargetCourse", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteCourse Course @relation("PrereqCourse", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)
}

model CourseOffering {
  id          String   @id @default(uuid())
  courseId    String
  semesterId  String
  sectionId   String
  facultyId   String
  classroomId String
  capacity    Int      @default(45)
  timingsSummary String? // e.g. "Mon 14:30 - 17:25"

  course             Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester           Semester             @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  section            Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  faculty            Faculty              @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  classroom          Classroom            @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  
  registrations      CourseRegistration[]
  timetables         Timetable[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  grades             Grade[]
  onlineExams        OnlineExam[]
  examSchedules      ExaminationSchedule[]
  materials          CourseMaterial[]
  surveys            Survey[]
}

model CourseRegistration {
  id               String   @id @default(uuid())
  studentId        String
  courseOfferingId String
  status           String   @default("APPROVED") // PENDING, APPROVED, REJECTED, DROPPED
  registrationDate DateTime @default(now())

  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseOfferingId])
}

model Timetable {
  id               String   @id @default(uuid())
  courseOfferingId String
  dayOfWeek        String   // Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday
  startTime        String   // "14:30"
  endTime          String   // "17:25"
  classroomId      String

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  classroom      Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
}

model CourseMaterial {
  id               String   @id @default(uuid())
  courseOfferingId String
  title            String
  description      String?
  fileUrl          String
  fileType         String   @default("PDF")
  uploadedAt       DateTime @default(now())

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// PROGRAM LEARNING OUTCOMES (PLO)
// -------------------------------------------------------------

model ProgramLearningOutcome {
  id          String   @id @default(uuid())
  programId   String
  code        String   // e.g. "PLO-1: Engineering Knowledge"
  description String

  program  Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  mappings CoursePLOMapping[]
  attainments PLOAttainment[]
}

model CoursePLOMapping {
  id      String @id @default(uuid())
  courseId String
  ploId   String
  weight  Float  @default(1.0)

  course Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  plo    ProgramLearningOutcome @relation(fields: [ploId], references: [id], onDelete: Cascade)
}

model PLOAttainment {
  id                   String   @id @default(uuid())
  studentId            String
  ploId                String
  attainmentPercentage Float
  evaluatedAt          DateTime @default(now())

  student Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plo     ProgramLearningOutcome @relation(fields: [ploId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// ATTENDANCE MANAGEMENT
// -------------------------------------------------------------

model AttendanceSession {
  id               String   @id @default(uuid())
  courseOfferingId String
  date             DateTime
  topic            String?
  createdAt        DateTime @default(now())

  courseOffering CourseOffering     @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  records        AttendanceRecord[]
}

model AttendanceRecord {
  id        String   @id @default(uuid())
  sessionId String
  studentId String
  status    String   // PRESENT, ABSENT, LATE, EXCUSED
  remarks   String?

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

// -------------------------------------------------------------
// EXAMINATIONS, SEATING, ASSESSMENTS & GRADES
// -------------------------------------------------------------

model Examination {
  id          String   @id @default(uuid())
  semesterId  String
  examType    String   // MIDTERM, FINAL, LAB
  title       String   // e.g. "Fall 2026 Final Examinations"
  startDate   DateTime
  endDate     DateTime
  isPublished Boolean  @default(false)

  semester  Semester              @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  schedules ExaminationSchedule[]
  admitCards AdmitCard[]
}

model ExaminationSchedule {
  id               String   @id @default(uuid())
  examinationId    String
  courseOfferingId String
  examDate         DateTime
  startTime        String   // "09:00"
  endTime          String   // "12:00"
  paperType        String   @default("THEORY") // THEORY, LAB

  examination    Examination    @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  rooms          ExamRoom[]
  seats          ExamSeat[]
}

model ExamRoom {
  id          String @id @default(uuid())
  scheduleId  String
  classroomId String
  facultyId   String?

  schedule  ExaminationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  classroom Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  faculty   Faculty?            @relation(fields: [facultyId], references: [id])
}

model ExamSeat {
  id          String @id @default(uuid())
  scheduleId  String
  studentId   String
  roomNumber  String
  seatNumber  String

  schedule ExaminationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student  Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, studentId])
}

model AdmitCard {
  id              String   @id @default(uuid())
  studentId       String
  examinationId   String
  challanVerified Boolean  @default(true)
  generatedAt     DateTime @default(now())
  barcode         String

  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examination Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)

  @@unique([studentId, examinationId])
}

model Assessment {
  id               String   @id @default(uuid())
  courseOfferingId String
  title            String   // e.g. "Midterm Exam", "Assignment 1", "Quiz 2"
  assessmentType   String   // QUIZ, ASSIGNMENT, MIDTERM, FINAL, PROJECT
  totalMarks       Float
  weightage        Float    // % contribution
  dueDate          DateTime?

  courseOffering CourseOffering     @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  results        AssessmentResult[]
}

model AssessmentResult {
  id           String   @id @default(uuid())
  assessmentId String
  studentId    String
  obtainedMarks Float
  remarks      String?
  submittedAt  DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
}

model Grade {
  id               String   @id @default(uuid())
  studentId        String
  courseOfferingId String
  totalMarks       Float
  gradeLetter      String   // A+, A, B+, B, C+, C, D, F
  gpaPoint         Float    // 4.00, 3.67, 3.33, etc.
  isFinalized      Boolean  @default(true)

  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseOfferingId])
}

// -------------------------------------------------------------
// ONLINE EXAM ENGINE
// -------------------------------------------------------------

model OnlineExam {
  id               String   @id @default(uuid())
  courseOfferingId String
  title            String
  instructions     String?
  durationMinutes  Int      @default(60)
  totalMarks       Float    @default(50.0)
  startsAt         DateTime
  endsAt           DateTime
  isActive         Boolean  @default(true)

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  questions      ExamQuestion[]
  attempts       ExamAttempt[]
}

model ExamQuestion {
  id           String   @id @default(uuid())
  onlineExamId String
  questionText String
  questionType String   // MCQ, SHORT_ANSWER
  marks        Float    @default(1.0)
  orderIndex   Int      @default(0)

  onlineExam OnlineExam    @relation(fields: [onlineExamId], references: [id], onDelete: Cascade)
  options    ExamOption[]
  answers    ExamAnswer[]
}

model ExamOption {
  id         String  @id @default(uuid())
  questionId String
  optionText String
  isCorrect  Boolean @default(false)

  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model ExamAttempt {
  id           String    @id @default(uuid())
  onlineExamId String
  studentId    String
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  totalScore   Float?
  status       String    @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, GRADED

  onlineExam OnlineExam   @relation(fields: [onlineExamId], references: [id], onDelete: Cascade)
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers    ExamAnswer[]

  @@unique([onlineExamId, studentId])
}

model ExamAnswer {
  id               String   @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  textAnswer       String?
  isAutoSaved      Boolean  @default(true)
  savedAt          DateTime @default(now())

  attempt  ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

// -------------------------------------------------------------
// FINANCE & ACCOUNTING
// -------------------------------------------------------------

model FeeStructure {
  id              String   @id @default(uuid())
  programId       String
  semesterNo      Int
  name            String
  totalAmount     Float
  academicSession String

  program    Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  components FeeComponent[]
}

model FeeComponent {
  id             String @id @default(uuid())
  feeStructureId String
  feeNature      String // Tuition Fee, Semester Charges, Security Deposit, Exam Fee, Admission Fee
  amount         Float

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
}

model FinancialLedger {
  id              String   @id @default(uuid())
  studentId       String
  semesterId      String?
  description     String   // "Fee structure", "Payment received", etc.
  feeNature       String   // "Tuition Fee", "Semester Charges", "Online Payment"
  session         String   // "Spring 2023", "Fall 2026"
  transactionDate DateTime @default(now())
  charging        Float    @default(0.0) // Debit
  amount          Float    @default(0.0) // Credit (Paid)
  currentBalance  Float    // Running balance
  transactionType String   // CHARGE, PAYMENT, ADJUSTMENT

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester Semester? @relation(fields: [semesterId], references: [id])
}

model FeeChallan {
  id            String   @id @default(uuid())
  studentId     String
  semesterId    String
  challanNumber String   @unique
  issueDate     DateTime @default(now())
  dueDate       DateTime
  totalAmount   Float
  payableAmount Float
  status        String   @default("PENDING") // PENDING, PAID, OVERDUE
  bankDetails   String?

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  payments Payment[]
}

model Payment {
  id               String   @id @default(uuid())
  challanId        String
  studentId        String
  amountPaid       Float
  paymentMethod    String   // BANK_DEPOSIT, ONLINE_TRANSFER, CREDIT_CARD
  paymentReference String   @unique
  paidAt           DateTime @default(now())
  status           String   @default("VERIFIED") // PENDING, VERIFIED, REJECTED
  verifiedBy       String?

  challan FeeChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  student Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentAdvance {
  id             String   @id @default(uuid())
  studentId      String
  amount         Float
  reason         String
  dateGranted    DateTime @default(now())
  currentBalance Float

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model FinancialAdjustment {
  id             String   @id @default(uuid())
  studentId      String
  amount         Float
  adjustmentType String   // WAIVER, SCHOLARSHIP, CORRECTION, PENALTY
  reason         String
  approvedBy     String
  date           DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// COMMUNICATION, TODOS, WORKFLOWS & SURVEYS
// -------------------------------------------------------------

model Announcement {
  id           String   @id @default(uuid())
  title        String
  content      String
  departmentId String?
  programId    String?
  priority     String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  publishedAt  DateTime @default(now())
  attachmentUrl String?
  isPinned     Boolean  @default(false)

  department Department? @relation(fields: [departmentId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  subject     String
  body        String
  isRead      Boolean  @default(false)
  sentAt      DateTime @default(now())

  sender    User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
}

model Todo {
  id          String    @id @default(uuid())
  studentId   String
  title       String
  courseTitle String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  category    String    @default("ACADEMIC") // ACADEMIC, EVALUATION, REGISTRATION

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Survey {
  id               String   @id @default(uuid())
  title            String
  description      String?
  courseOfferingId String
  semesterId       String
  dueDate          DateTime
  isActive         Boolean  @default(true)

  courseOffering CourseOffering   @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  questions      SurveyQuestion[]
  responses      SurveyResponse[]
}

model SurveyQuestion {
  id           String @id @default(uuid())
  surveyId     String
  questionText String
  questionType String @default("RATING") // RATING, TEXT
  orderIndex   Int    @default(0)

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}

model SurveyResponse {
  id               String   @id @default(uuid())
  surveyId         String
  studentId        String
  courseOfferingId String
  answersJson      String   // serialized JSON map of answers
  submittedAt      DateTime @default(now())

  survey  Survey  @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([surveyId, studentId])
}

model Workflow {
  id                 String   @id @default(uuid())
  studentId          String
  requestType        String   // FEE_INSTALLMENT, COURSE_WITHDRAWAL, LEAVE, CLEARANCE, TRANSCRIPT_REQUEST
  title              String
  description        String
  status             String   @default("PENDING") // PENDING, APPROVED, REJECTED
  currentApproverRole String  // FINANCE_OFFICER, REGISTRAR, DEPT_HEAD
  createdAt          DateTime @default(now())

  student Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  steps   WorkflowApproval[]
}

model WorkflowApproval {
  id           String   @id @default(uuid())
  workflowId   String
  approverId   String
  approverRole String
  status       String   // APPROVED, REJECTED
  comments     String?
  approvedAt   DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id           String   @id @default(uuid())
  studentId    String
  departmentId String?
  subject      String
  description  String
  priority     String   @default("NORMAL")
  status       String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  createdAt    DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

